# Store text files with LF in the repo; each OS checks out its native line endings.
* text=auto

# Shell scripts, systemd units and plists must keep LF, even in a Windows checkout.
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.plist text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
