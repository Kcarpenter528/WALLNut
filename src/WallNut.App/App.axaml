<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WallNut.App.App"
             Name="WALLNut"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark setting. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
