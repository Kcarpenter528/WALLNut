<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WallNut.App.Views"
        x:Class="WallNut.App.Views.NotificationSettingsView"
        x:DataType="vm:SettingsViewModel"
        >

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Message}" Classes="hint" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="TestButton" Content="Send test notification" />
                    <Button Name="SaveButton" Content="Save" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Padding="20,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Desktop notifications" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Choose what WALLNut tells you about. These settings are yours alone." Classes="hint" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding ServiceStatus}" Classes="hint" Margin="0,4,0,8" />

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="Notifications on" OffContent="Notifications off" />
                        <TextBlock Classes="hint" Text="Turning this off silences everything except shutdown warnings." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Wait before announcing a power failure:" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding OnBatteryDelaySeconds}" Minimum="0" Maximum="300" Increment="1"
                                           FormatString="0" Width="130" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="hint"
                                   Text="If power comes back within this time it was just a blip, and you won't be bothered. Low battery and shutdown warnings are never delayed." />
                    </StackPanel>
                </Border>

                <TextBlock Classes="section" Text="What to notify me about" />
                <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding Enabled}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupItem">
                            <Border Classes="card">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Classes="hint" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEdit}"
                                                      OnContent="" OffContent="" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Kinds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KindItem">
                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Enabled}"
                                                          IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding Tip}" Margin="0,0,16,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="section" Text="Which UPSes" />
                <Border Classes="card" IsEnabled="{Binding Enabled}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="hint" IsVisible="{Binding !HasUps}"
                                   Text="UPSes appear here once the WALLNut service is running." />
                        <ItemsControl ItemsSource="{Binding Ups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UpsItem">
                                    <CheckBox IsChecked="{Binding Notify}" Margin="0,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Detail}" Classes="hint" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
