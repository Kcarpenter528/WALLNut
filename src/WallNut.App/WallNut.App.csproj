<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WALLNut tray app: lives in the notification area, shows desktop notifications,
       and (later) opens the dashboard. One copy runs per logged-in user. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- On Windows, target the Windows SDK so we can show native toast notifications. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wallnut.ico</ApplicationIcon>
    <AssemblyName>WALLNut</AssemblyName>
    <RootNamespace>WallNut.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallNut.Shared\WallNut.Shared.csproj" />
    <ProjectReference Include="..\WallNut.Charts\WallNut.Charts.csproj" />
  </ItemGroup>

  <!-- SkiaSharp/HarfBuzz packages ship ~100 MB of native debug symbols; installs don't need them. -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish" Condition="'$(DebugType)' == 'none'">
    <ItemGroup>
      <_WallNutPublishedPdbs Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_WallNutPublishedPdbs)" />
  </Target>
</Project>
