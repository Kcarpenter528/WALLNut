<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-WallNut.Service-38b61cd4-86ad-4010-b7e5-19179aece947</UserSecretsId>
    <!-- Not hosted in IIS and serves no web pages: skip web.config and static web assets. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development settings (simulator endpoints) never ship. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallNut.Nut\WallNut.Nut.csproj" />
    <ProjectReference Include="..\WallNut.Shared\WallNut.Shared.csproj" />
    <ProjectReference Include="..\WallNut.History\WallNut.History.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>
</Project>
