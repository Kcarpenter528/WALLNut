{
  // Development adds the three UPSes from the simulator (run: dotnet run --project src/WallNut.Simulator).
  // "localhost" also exercises DNS name lookup.
  "WallNut": {
    "Endpoints": {
      "sim-rack": { "DisplayName": "Sim rack (full-featured)", "Host": "localhost", "Ups": "rack", "PollIntervalSeconds": 2 },
      // In Development, pretend this PC is plugged into the simulated office UPS (test mode only).
      "sim-office": {
        "DisplayName": "Sim office (Back-UPS)", "Host": "127.0.0.1", "Ups": "office", "PollIntervalSeconds": 2,
        "Role": "PowersThisMachine", "Username": "monuser", "Password": "secret"
      },
      "sim-dc": { "DisplayName": "Sim data center (3-phase)", "Host": "localhost", "Ups": "dc", "PollIntervalSeconds": 2 }
    },
    "Reconnect": { "InitialDelaySeconds": 1, "MaxDelaySeconds": 10 },
    "Shutdown": { "DryRun": true },
    // Its own local API name, so it can run next to an installed WALLNut service.
    // Run the tray app with WALLNUT_ENDPOINT=WallNut.Service.Dev to talk to it.
    "Api": { "Endpoint": "WallNut.Service.Dev" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WallNut": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
