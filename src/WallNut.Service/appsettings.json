{
  "WallNut": {
    // One entry per UPS. The key ("nas") is its id; each gets its own connection.
    // Host can be an IP address or a DNS name (e.g. "diskstation.local").
    // Role: "Monitor" (watch and alert only) or "PowersThisMachine" (can trigger a shutdown here;
    // needs Username/Password so WALLNut can log in like NUT's upsmon).
    "Endpoints": {
      "nas": {
        "DisplayName": "Synology NAS",
        "Host": "192.168.1.10",
        "Port": 3493,
        "Ups": "ups",
        "Username": "monuser",
        "Password": "secret",
        "Role": "Monitor",
        "PollIntervalSeconds": 5,
        "TimeoutSeconds": 10
      }
    },
    "Reconnect": {
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 60
    },
    // When to shut THIS machine down. Only endpoints with Role "PowersThisMachine" count.
    "Shutdown": {
      "Enabled": true,
      // Test mode: logs "would shut down" instead of doing it. Set to false only after testing.
      "DryRun": true,
      "Action": "Shutdown",              // or "Hibernate"
      "MinimumSupplies": 1,              // a server with two PSUs on two UPSes can use 1 to survive one UPS failing
      "RespectForcedShutdown": true,     // shut down when the NAS says so (FSD)
      "OnLowBattery": true,              // shut down when the UPS reports low battery
      "BatteryChargeBelowPercent": null, // e.g. 30 to go earlier than the UPS's own low-battery point
      "RuntimeBelowSeconds": null,       // e.g. 300
      "OnBatteryForSeconds": null,       // e.g. 600 to leave after 10 minutes on battery regardless
      "LostWhileOnBatterySeconds": 15,   // fail-safe: contact lost this long while on battery = shut down
      "FinalDelaySeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
