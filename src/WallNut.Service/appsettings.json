{
  "WallNut": {
    // One entry per UPS. The key ("nas") is its id; each gets its own connection.
    // Host can be an IP address or a DNS name (e.g. "diskstation.local").
    // Role: "Monitor" (watch and alert only) or "PowersThisMachine" (can trigger a shutdown here;
    // needs Username/Password so WALLNut can log in like NUT's upsmon).
    "Endpoints": {
      "nas": {
        "DisplayName": "Synology NAS",
        "Host": "192.168.1.10",
        "Port": 3493,
        "Ups": "ups",
        "Username": "monuser",
        "Password": "secret",
        "Role": "Monitor",
        "PollIntervalSeconds": 5,
        "TimeoutSeconds": 10
      }
    },
    "Reconnect": {
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
