{
  // Built-in defaults. Don't edit this file on an installed system: put your settings in the
  // machine config file instead, which upgrades never overwrite:
  //   Windows: C:\ProgramData\WALLNut\config.json
  //   Linux:   /etc/wallnut/config.json
  //   macOS:   /Library/Application Support/WALLNut/config.json
  // See packaging/config.example.json for every setting.
  "WallNut": {
    "Endpoints": {},
    "Reconnect": {
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 60
    },
    "Shutdown": {
      "Enabled": true,
      "DryRun": true,
      "Action": "Shutdown",
      "MinimumSupplies": 1,
      "RespectForcedShutdown": true,
      "OnLowBattery": true,
      "BatteryChargeBelowPercent": null,
      "RuntimeBelowSeconds": null,
      "OnBatteryForSeconds": null,
      "LostWhileOnBatterySeconds": 15,
      "FinalDelaySeconds": 5
    },
    "History": {
      "Enabled": true,
      "DatabasePath": null,          // default: history.db in the data folder
      "SampleIntervalSeconds": 15,
      "RawDays": 3,                  // every sample
      "FiveMinuteDays": 90,          // 5-minute average / min / max
      "HourlyDays": 730,             // hourly average / min / max
      "EventDays": 730
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
