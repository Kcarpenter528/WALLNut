<Project Sdk="Microsoft.NET.Sdk">

  <!-- A fake NUT server (upsd) with simulated UPS devices, for development and tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>wallnut-sim</AssemblyName>
    <RootNamespace>WallNut.Simulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- From Network UPS Tools (GPL-2.0-or-later): variable/command descriptions and the naming spec. -->
    <EmbeddedResource Include="Reference\cmdvartab" LogicalName="cmdvartab" />
    <EmbeddedResource Include="Reference\nut-names.txt" LogicalName="nut-names.txt" />
    <EmbeddedResource Include="Profiles\*.json" LogicalName="profile.%(Filename)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallNut.Nut\WallNut.Nut.csproj" />
    <ProjectReference Include="..\WallNut.History\WallNut.History.csproj" />
  </ItemGroup>

</Project>
